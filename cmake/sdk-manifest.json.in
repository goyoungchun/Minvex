{
  "format": "MinvexSdk",
  "version": "@PROJECT_VERSION@",
  "license": "Apache-2.0",
  "licenseScope": "Minvex project-authored code; third-party works retain their own licenses.",
  "licenseFiles": ["LICENSE", "NOTICE"],
  "licenseFilesRelativeTo": "SDK prefix",
  "flavor": "@MINVEX_PACKAGE_FLAVOR@",
  "system": "@CMAKE_SYSTEM_NAME@",
  "processor": "@CMAKE_SYSTEM_PROCESSOR@",
  "macosDeploymentTarget": "@CMAKE_OSX_DEPLOYMENT_TARGET@",
  "compiler": "@CMAKE_CXX_COMPILER_ID@-@CMAKE_CXX_COMPILER_VERSION@",
  "msvcToolset": "@MINVEX_SDK_MSVC_TOOLSET@",
  "pointerBytes": @CMAKE_SIZEOF_VOID_P@,
  "configuration": "$<CONFIG>",
  "runtime": "@MINVEX_SDK_RUNTIME@",
  "components": [@_sdk_manifest_components@],
  "sceneVersion": 13,
  "terrainSceneVersion": 14,
  "poseVersion": 1,
  "qualityVersion": 2,
  "uiVersion": 3,
  "importVersion": 6,
  "linkage": "static",
  "abiPolicy": "Rebuild consumers with the same compiler toolset, architecture, configuration and C++ runtime.",
  "publication": "installed C++ SDK"
}
