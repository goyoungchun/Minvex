cmake_minimum_required(VERSION 3.24)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_root}/CMakeLists.txt" _cmake)
string(REGEX MATCH "project\\(Minvex VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)" _match "${_cmake}")
set(_version "${CMAKE_MATCH_1}")
if(NOT _version)
    message(FATAL_ERROR "Cannot read the Minvex project version")
endif()
file(READ "${_root}/pyproject.toml" _python)
string(REGEX MATCH "version = \"([0-9]+\\.[0-9]+\\.[0-9]+)\"" _match "${_python}")
if(NOT CMAKE_MATCH_1 STREQUAL _version)
    message(FATAL_ERROR "Python package version differs from ${_version}")
endif()
file(READ "${_root}/web/package.json" _web)
string(JSON _web_version GET "${_web}" version)
if(NOT _web_version STREQUAL _version)
    message(FATAL_ERROR "Web package version differs from ${_version}")
endif()
if(DEFINED EXPECTED_VERSION AND NOT EXPECTED_VERSION STREQUAL _version)
    message(FATAL_ERROR "Expected release ${EXPECTED_VERSION}, source is ${_version}")
endif()
string(REPLACE "." "\\." _tag_version "${_version}")
if(DEFINED RELEASE_TAG AND NOT RELEASE_TAG STREQUAL "v${_version}" AND NOT RELEASE_TAG MATCHES "^v${_tag_version}-rc\\.[0-9]+$")
    message(FATAL_ERROR "Tag ${RELEASE_TAG} does not match source version ${_version}")
endif()
file(READ "${_root}/third_party/versions.json" _manifest)
foreach(_dependency imguizmo meshoptimizer ltc)
    string(JSON _count LENGTH "${_manifest}" "${_dependency}" sha256)
    math(EXPR _last "${_count}-1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _file MEMBER "${_manifest}" "${_dependency}" sha256 ${_index})
        string(JSON _expected GET "${_manifest}" "${_dependency}" sha256 "${_file}")
        file(SHA256 "${_root}/third_party/${_dependency}/${_file}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "Vendored checksum mismatch: ${_dependency}/${_file}")
        endif()
    endforeach()
endforeach()
message(STATUS "Minvex ${_version}: C++/Python/Web versions and vendored checksums match")
